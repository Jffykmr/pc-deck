# Read by host-agent/agent.py at startup. All values are optional.

# Port and interface the deck listens on. With port 80 the tablet URL has no
# port: http://<pc-address>
DECK_PORT=80
DECK_HOST=0.0.0.0

# Devices pair with a one-time code (open http://localhost:<port>/pair on the PC).
# Optional legacy shared token, accepted in addition to paired devices.
DECK_TOKEN=

# Where config.json and devices.json live. Default: ../data next to host-agent.
# DECK_DATA_DIR=

# Only needed if spacedesk is installed somewhere non-standard.
# SPACEDESK_EXE=C:\Program Files\datronicsoft\spacedesk\spacedeskConsole.exe
